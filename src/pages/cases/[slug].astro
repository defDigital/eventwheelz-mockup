---
import { getCollection, getEntries } from 'astro:content';
import { Image } from 'astro:assets';
import Basis from '../../layouts/Basis.astro';
import PaginaKop from '../../components/PaginaKop.astro';
import VoertuigKaart from '../../components/VoertuigKaart.astro';
import CtaBlok from '../../components/CtaBlok.astro';
import DrieLuik from '../../components/DrieLuik.astro';
import Cijfers from '../../components/Cijfers.astro';
import Quote from '../../components/Quote.astro';
import Fotostrook from '../../components/Fotostrook.astro';
import { foto, logo } from '../../lib/beeld';
import { link, raster } from '../../lib/pad';

export async function getStaticPaths() {
  const cases = await getCollection('cases');
  return cases.map((c) => ({ params: { slug: c.data.slug }, props: { item: c } }));
}

const { item } = Astro.props;
const d = item.data;
const pad = Astro.url.pathname;
const voertuigen = await getEntries(d.voertuigen);
const inzet = await getEntries(d.inzet);
const beeld = foto(d.foto);
const merk = logo(d.logo);

const drieluik = [
  { kop: 'De opdracht', tekst: d.opdracht },
  { kop: 'Onze aanpak', tekst: d.aanpak },
  { kop: 'Het resultaat', tekst: d.resultaat },
];
---
<Basis titel={`${d.klant} — case van Eventwheelz`} omschrijving={`${d.kort} Case van Eventwheelz, onderdeel van Unieke Uitjes.`}>
  <PaginaKop
    eyebrow="Case"
    titel={d.klant}
    intro={d.kort}
    variant="beeld"
    beeld={beeld}
    beeldAlt={`Eventwheelz bij ${d.klant}`}
    terug={{ naar: '/cases', label: 'Alle cases' }}>
    {merk && (
      <span class="merk"><Image src={merk} alt={d.klant} height={40} loading="eager" /></span>
    )}
  </PaginaKop>

  <section class="section">
    <div class="wrap">
      <div class="case-body">
        <div class="tekst">
          {d.verhaal.map((alinea: string) => <p data-dummy>{alinea}</p>)}
        </div>
        <aside class="feiten">
          <div class="feit">
            <span class="feit-label">Inzet</span>
            <span class="feit-waarde">
              {inzet.map((u) => <a href={link(pad, `/inzet/${u.data.slug}`)}>{u.data.naam}</a>)}
            </span>
          </div>
          {d.jaar && (
            <div class="feit">
              <span class="feit-label">Jaar</span>
              <span class="feit-waarde">{d.jaar}</span>
            </div>
          )}
          <div class="feit">
            <span class="feit-label">Voertuigen</span>
            <span class="feit-waarde">
              {voertuigen.map((v) => <a href={link(pad, `/voertuigen/${v.data.slug}`)}>{v.data.naam}</a>)}
            </span>
          </div>
        </aside>
      </div>

      <div class="drieluik-wrap">
        <DrieLuik blokken={drieluik} />
      </div>
    </div>
  </section>

  {d.cijfers.length > 0 && (
    <Cijfers eyebrow="In cijfers" titel="Wat er stond" cijfers={d.cijfers} />
  )}

  <Fotostrook bestanden={d.fotos} alt={`Eventwheelz bij ${d.klant}`} />

  {d.quote && <Quote tekst={d.quote.tekst} naam={d.quote.naam} rol={d.quote.rol} />}

  {voertuigen.length > 0 && (
    <section class="section is-band">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow">Ingezet bij deze case</span>
          <h2>De voertuigen die er stonden</h2>
        </div>
        <div class:list={['grid', raster(voertuigen.length)]}>
          {voertuigen.map((v) => <VoertuigKaart voertuig={v} huidigPad={pad} />)}
        </div>
      </div>
    </section>
  )}

  <CtaBlok huidigPad={pad} />
</Basis>

<style>
  .merk{
    display:inline-flex;align-items:center;justify-content:center;
    margin-top:var(--s-5);
    background:var(--white);border-radius:var(--radius);
    padding:var(--s-3) var(--s-4);
  }
  .merk :global(img){height:40px;width:auto;object-fit:contain;}
  .drieluik-wrap{margin-top:var(--s-8);}
  .case-body{display:grid;grid-template-columns:1.6fr 1fr;gap:var(--s-8);align-items:start;}
  .tekst{display:flex;flex-direction:column;gap:var(--s-4);}
  .tekst p{color:var(--body);}
  .feiten{background:var(--band-bg);border:1px solid var(--line);border-radius:var(--radius);padding:var(--s-5);display:flex;flex-direction:column;gap:var(--s-4);}
  .feit{display:flex;flex-direction:column;gap:var(--s-1);}
  .feit-label{font-weight:700;font-size:.74rem;letter-spacing:.12em;text-transform:uppercase;color:var(--accent);}
  .feit-waarde{display:flex;flex-wrap:wrap;gap:var(--s-3);color:var(--white);font-weight:700;font-size:.92rem;}
  .feit-waarde a{color:var(--white);}
  @media (max-width:991px){ .case-body{grid-template-columns:1fr;gap:var(--s-5);} }
</style>
