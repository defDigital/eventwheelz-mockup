---
import Basis from '../layouts/Basis.astro';
import PaginaKop from '../components/PaginaKop.astro';
import Logobalk from '../components/Logobalk.astro';
import CtaBlok from '../components/CtaBlok.astro';
import Stappen from '../components/Stappen.astro';
import Cijfers from '../components/Cijfers.astro';
import DrieLuik from '../components/DrieLuik.astro';
const pad = Astro.url.pathname;

// Vestigingen uit de handtekening van Roel. Niet verzonnen, wel controleren
// of ze alle drie op de Eventwheelz-site horen te staan.
const stappen = [
  { titel: 'Je vertelt wat je nodig hebt', tekst: 'Vulzin om de lengte van dit blok te tonen. De echte tekst volgt later.' },
  { titel: 'Wij maken een voorstel', tekst: 'Hier komt straks de echte tekst te staan, ongeveer even lang als deze.' },
  { titel: 'Bezorgen en instructie', tekst: 'Vulzin om de lengte van dit blok te tonen. De echte tekst volgt later.' },
  { titel: 'Ophalen na afloop', tekst: 'Deze korte tekst laat zien hoeveel ruimte er is. Nog niet definitief.' },
];

// Getallen nog opvragen bij Roel. Vorm staat, cijfers volgen.
const cijfers = [
  { getal: '000', label: 'voertuigen in de vloot' },
  { getal: '00', label: 'evenementen per jaar' },
  { getal: '0', label: 'vestigingen' },
];

const waarom = [
  { kop: 'Alles uit één hand', tekst: 'Vulzin om de lengte van dit blok te tonen. De echte tekst volgt later.' },
  { kop: 'Nooit stilstand', tekst: 'Hier komt straks de echte tekst te staan, ongeveer even lang als deze.' },
  { kop: 'Ervaring op locatie', tekst: 'Vulzin om de lengte van dit blok te tonen. De echte tekst volgt later.' },
];

const vestigingen = [
  { plaats: 'Laren Gld.', adres: 'Deventerweg 67C', postcode: '7245 PJ' },
  { plaats: 'Borculo', adres: 'Korenbree 58', postcode: '7271 LH' },
  { plaats: 'Winterswijk', adres: 'Europark 6', postcode: '7102 AM' },
];
---
<Basis titel="Over Eventwheelz — onderdeel van Unieke Uitjes" omschrijving="Eventwheelz is het evenementenmerk van Unieke Uitjes. Wij leveren de voertuigen, de accu's en de logistiek.">
  <PaginaKop
    eyebrow="Over ons"
    titel="Onderdeel van Unieke Uitjes"
    intro="Dezelfde vloot en dezelfde mensen als bij Unieke Uitjes, maar dan ingericht op wat een evenement nodig heeft." />

  <section class="section">
    <div class="wrap over-grid">
      <div class="tekst">
        <p data-dummy>Hier komt straks de echte tekst te staan. Deze regels dienen alleen om te laten zien hoeveel ruimte een alinea inneemt en hoe de regels afbreken op verschillende schermformaten.</p>
        <p data-dummy>Deze alinea is met opzet iets langer, zodat je kunt zien wat er gebeurt als een blok meer tekst krijgt dan gemiddeld. De echte tekst schrijven we pas als de vormgeving vaststaat.</p>
      </div>

      <aside class="paneel">
        <h2 class="paneel-kop">Vestigingen van Unieke Uitjes</h2>
        <ul class="vestigingen">
          {vestigingen.map((v) => (
            <li>
              <strong>{v.plaats}</strong>
              <span>{v.adres}</span>
              <span>{v.postcode}</span>
            </li>
          ))}
        </ul>
        <p class="paneel-note">
          Landelijke inzet. <a href="https://www.uniekeuitjes.nl">uniekeuitjes.nl</a>
        </p>
      </aside>
    </div>
  </section>

  <section class="section is-band">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Waarom Eventwheelz</span>
        <h2>Wat je van ons kunt verwachten</h2>
      </div>
      <DrieLuik blokken={waarom} />
    </div>
  </section>

  <Stappen titel="Van aanvraag tot ophalen" eyebrow="Hoe het werkt" stappen={stappen} />

  <Cijfers eyebrow="De vloot" titel="Eventwheelz in cijfers" cijfers={cijfers} />

  <Logobalk />
  <CtaBlok huidigPad={pad} />
</Basis>

<style>
  .over-grid{display:grid;grid-template-columns:1.6fr 1fr;gap:var(--s-8);align-items:start;}
  .tekst{display:flex;flex-direction:column;gap:var(--s-4);max-width:64ch;}
  .tekst p{color:var(--body);}
  .paneel{background:var(--band-bg);border:1px solid var(--line);border-radius:var(--radius);padding:var(--s-5);}
  .paneel-kop{font-size:1.05rem;margin-bottom:var(--s-4);}
  .vestigingen{display:flex;flex-direction:column;gap:var(--s-4);}
  .vestigingen li{display:flex;flex-direction:column;}
  .vestigingen strong{color:var(--white);}
  .vestigingen span{color:var(--muted);font-size:.9rem;}
  .paneel-note{margin-top:var(--s-4);padding-top:var(--s-4);border-top:1px solid var(--line);color:var(--muted);font-size:.88rem;}
  @media (max-width:991px){ .over-grid{grid-template-columns:1fr;gap:var(--s-6);} }
</style>
