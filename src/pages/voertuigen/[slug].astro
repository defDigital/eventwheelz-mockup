---
import { getCollection, getEntries } from 'astro:content';
import { Image } from 'astro:assets';
import Basis from '../../layouts/Basis.astro';
import PaginaKop from '../../components/PaginaKop.astro';
import CtaBlok from '../../components/CtaBlok.astro';
import Stappen from '../../components/Stappen.astro';
import Faq from '../../components/Faq.astro';
import VoertuigKaart from '../../components/VoertuigKaart.astro';
import { foto } from '../../lib/beeld';
import { link, raster } from '../../lib/pad';

export async function getStaticPaths() {
  const voertuigen = await getCollection('voertuigen');
  return voertuigen.map((v) => ({ params: { slug: v.data.slug }, props: { voertuig: v } }));
}

const { voertuig } = Astro.props;
const d = voertuig.data;
const pad = Astro.url.pathname;
const inzet = await getEntries(d.inzet);

// Alleen tonen wat we weten. Drie regels die alle drie 'nog aanleveren'
// zeggen lezen als een bouwput.
const specs = [
  { label: 'Aantal personen', waarde: d.aantalPersonen },
  { label: 'Actieradius', waarde: d.actieradius },
  { label: 'Rijbewijs', waarde: d.rijbewijs },
].filter((s) => s.waarde !== null);

// Levering en ophalen gaan voor elk voertuig hetzelfde.
const stappen = [
  { titel: 'Je vraagt een offerte aan', tekst: 'Vulzin om de lengte van dit blok te tonen. De echte tekst volgt later.' },
  { titel: 'Wij bezorgen op locatie', tekst: 'Hier komt straks de echte tekst te staan, ongeveer even lang als deze.' },
  { titel: 'Rijden, en accu wisselen', tekst: 'Vulzin om de lengte van dit blok te tonen. De echte tekst volgt later.' },
  { titel: 'Wij halen alles weer op', tekst: 'Deze korte tekst laat zien hoeveel ruimte er is. Nog niet definitief.' },
];

// Andere voertuigen, voor onderaan de pagina.
const alle = (await getCollection('voertuigen')).sort((a, b) => a.data.volgorde - b.data.volgorde);
const anderen = alle.filter((v) => v.id !== voertuig.id).slice(0, 3);
const galerij = d.galerij.map((b: string) => foto(b)).filter(Boolean);
---
<Basis titel={`${d.naam} huren — Eventwheelz`} omschrijving={d.kort}>
  <PaginaKop
    eyebrow="Onze wheels"
    titel={d.naam}
    intro={d.kort}
    variant="split"
    beeld={foto(d.hoofdfoto)}
    beeldAlt={`${d.naam} van Eventwheelz`}
    terug={{ naar: '/voertuigen', label: 'Alle wheels' }}>
    <p class="kop-payoff">{d.payoff}</p>
    {d.vanafprijs !== null && (
      <p class="kop-prijs">v.a. &euro; {d.vanafprijs},- {d.prijsEenheid}</p>
    )}
  </PaginaKop>

  <section class="section">
    <div class="wrap">
      <div class="detail-tekst">
        {d.lang.map((alinea: string) => <p data-dummy>{alinea}</p>)}
      </div>

      {galerij.length > 0 && (
        <div class:list={['galerij', galerij.length === 1 && 'is-enkel']}>
          {galerij.map((b) => (
            <Image src={b!} alt={`${d.naam} van Eventwheelz`} widths={[600, 1000]}
                   sizes="(max-width:767px) 100vw, 560px" loading="lazy" />
          ))}
        </div>
      )}

      <div class="panelen">
        <div class="paneel">
          <h2 class="paneel-kop">Bij de prijs inbegrepen</h2>
          <ul class="inbegrepen-lijst">
            {d.inbegrepen.map((i: string) => <li>{i}</li>)}
          </ul>
          {d.accuwissel && (
            <p class="paneel-note">Accu wisselen in plaats van omruilen. Bij elke 5 stuks 1 extra accu gratis mee.</p>
          )}
        </div>

        {inzet.length > 0 && (
          <div class="paneel">
            <h2 class="paneel-kop">Waarvoor je hem inzet</h2>
            <div class="koppeling-lijst">
              {inzet.map((u) => (
                <a class="chip" href={link(pad, `/inzet/${u.data.slug}`)}>{u.data.naam}</a>
              ))}
            </div>
          </div>
        )}

        {specs.length > 0 && (
          <div class="paneel">
            <h2 class="paneel-kop">Specificaties</h2>
            <dl class="specs">
              {specs.map((s) => (
                <div class="spec-rij">
                  <dt>{s.label}</dt>
                  <dd>{s.waarde}</dd>
                </div>
              ))}
            </dl>
          </div>
        )}
      </div>

      <a class="button is-primary" href={link(pad, '/contact')}>Offerte aanvragen</a>
    </div>
  </section>

  <Stappen titel="Van aanvraag tot ophalen" stappen={stappen} />

  <Faq vragen={d.faq} />

  {anderen.length > 0 && (
    <section class="section is-band">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow">Vaak samen gehuurd</span>
          <h2>Ook interessant</h2>
        </div>
        <div class:list={['grid', raster(anderen.length, 3)]}>
          {anderen.map((v) => <VoertuigKaart voertuig={v} huidigPad={pad} />)}
        </div>
      </div>
    </section>
  )}

  <CtaBlok huidigPad={pad} />
</Basis>

<style>
  .kop-payoff{
    margin-top:var(--s-5);
    font-family:var(--f-display);
    font-size:clamp(1.3rem,1.1rem + 1vw,1.9rem);
    line-height:1.15;
    text-transform:uppercase;
    color:var(--accent);
    max-width:22ch;
  }
  .kop-prijs{
    margin-top:var(--s-5);
    display:inline-flex;align-items:center;
    padding:var(--s-2) var(--s-4);
    border-radius:var(--radius-pill);
    background:rgba(8,30,58,.45);
    font-weight:700;color:var(--accent);
  }
  .detail-tekst{display:flex;flex-direction:column;gap:var(--s-4);max-width:64ch;}
  .detail-tekst p{color:var(--body);}

  .galerij{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(320px,1fr));
    gap:var(--s-4);
    margin-top:var(--s-6);
  }
  .galerij :global(img){
    width:100%;height:100%;
    aspect-ratio:4/3;object-fit:cover;
    border-radius:var(--radius);
  }
  /* Eén foto krijgt de volle breedte en houdt zijn eigen verhouding, anders
     snijd je een liggende foto onnodig bij tot 4:3. */
  .galerij.is-enkel{grid-template-columns:1fr;}
  .galerij.is-enkel :global(img){height:auto;aspect-ratio:auto;}

  .panelen{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
    gap:var(--s-4);
    margin-top:var(--s-7);
    align-items:start;
  }
  .paneel{background:var(--band-bg);border:1px solid var(--line);border-radius:var(--radius);padding:var(--s-5);}
  .paneel-kop{font-size:1.05rem;margin-bottom:var(--s-4);}
  .specs{margin:0;}
  .spec-rij{display:flex;justify-content:space-between;gap:var(--s-4);padding:var(--s-3) 0;border-top:1px solid var(--line);}
  .spec-rij:first-child{border-top:0;}
  .spec-rij dt{color:var(--muted);font-size:.9rem;}
  .spec-rij dd{margin:0;color:var(--white);font-weight:700;font-size:.9rem;text-align:right;}
  .inbegrepen-lijst{display:flex;flex-direction:column;gap:var(--s-2);}
  .inbegrepen-lijst li{color:var(--body);font-size:.92rem;padding-left:var(--s-4);position:relative;}
  .inbegrepen-lijst li::before{content:"";position:absolute;left:0;top:.6em;width:6px;height:6px;border-radius:50%;background:var(--accent);}
  .paneel-note{margin-top:var(--s-4);padding-top:var(--s-4);border-top:1px solid var(--line);color:var(--muted);font-size:.86rem;}
  .koppeling-lijst{display:flex;flex-wrap:wrap;gap:var(--s-3);}
  .chip{
    display:inline-flex;align-items:center;min-height:44px;
    padding:0 var(--s-4);
    border:1px solid var(--line);border-radius:var(--radius-pill);
    color:var(--white);text-decoration:none;font-weight:700;font-size:.85rem;
  }
  .chip:hover{border-color:var(--accent);color:var(--accent);}
  .button{margin-top:var(--s-6);}

  @media (max-width:767px){ .galerij{grid-template-columns:1fr;} }
</style>
