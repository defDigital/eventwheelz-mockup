---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Basis from '../layouts/Basis.astro';
import PaginaKop from '../components/PaginaKop.astro';
import CtaBlok from '../components/CtaBlok.astro';
import { foto } from '../lib/beeld';
import { link } from '../lib/pad';

const pad = Astro.url.pathname;
const usecases = (await getCollection('usecases')).sort((a, b) => a.data.volgorde - b.data.volgorde);
---
<Basis titel="Inzet — Eventwheelz" omschrijving="Crew mobility, people mobility en branded mobility. Drie manieren om Eventwheelz op je evenement in te zetten.">
  <PaginaKop
    eyebrow="Drie implementaties, een vloot"
    titel="Waar zet je Eventwheelz voor in?"
    intro="Meestal loopt het door elkaar heen op hetzelfde terrein. Je crew rijdt backstage, je gasten worden rondgereden en er staat een gewrapt voertuig tussen." />

  <section class="section">
    <div class="wrap">
      <div class="grid is-3">
        {usecases.map((u) => {
          const beeld = foto(u.data.hoofdfoto);
          return (
            <a class="panel" href={link(pad, `/inzet/${u.data.slug}`)}>
              {beeld && <Image src={beeld} alt={u.data.kort} widths={[400, 800]} sizes="(max-width:767px) 100vw, 380px" loading="lazy" />}
              <div class="panel-body">
                <span class="panel-num">{u.data.nummer} / {u.data.label}</span>
                <h2>{u.data.naam}</h2>
                <p>{u.data.kort}</p>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <CtaBlok huidigPad={pad} />
</Basis>

<style>
  .panel-body h2{font-size:var(--h3);margin-bottom:var(--s-2);}
</style>
