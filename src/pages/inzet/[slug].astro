---
import { getCollection, getEntries } from 'astro:content';
import { Image } from 'astro:assets';
import Basis from '../../layouts/Basis.astro';
import PaginaKop from '../../components/PaginaKop.astro';
import Kruimel from '../../components/Kruimel.astro';
import VoertuigKaart from '../../components/VoertuigKaart.astro';
import CtaBlok from '../../components/CtaBlok.astro';
import { foto } from '../../lib/beeld';
import { link } from '../../lib/pad';

export async function getStaticPaths() {
  const usecases = await getCollection('usecases');
  return usecases.map((u) => ({ params: { slug: u.data.slug }, props: { usecase: u } }));
}

const { usecase } = Astro.props;
const d = usecase.data;
const pad = Astro.url.pathname;
const voertuigen = await getEntries(d.voertuigen);

// Welke cases hebben deze inzet? Dit is de koppeling die in Webflow een
// multi-reference wordt.
const alleCases = await getCollection('cases');
const cases = alleCases
  .filter((c) => c.data.inzet.some((r: any) => r.id === usecase.id))
  .sort((a, b) => a.data.volgorde - b.data.volgorde);

const beeld = foto(d.hoofdfoto);
---
<Basis titel={`${d.naam} — Eventwheelz`} omschrijving={d.kort}>
  <PaginaKop eyebrow={`${d.nummer} / ${d.label}`} titel={d.naam} intro={d.kort} />

  <section class="section">
    <div class="wrap">
      <Kruimel naar="/inzet" label="Alle inzetten" />

      {beeld && (
        <Image class="hoofdbeeld" src={beeld} alt={d.kort} widths={[800, 1400]} sizes="100vw" loading="eager" />
      )}

      <div class="tekst">
        {d.lang.map((alinea: string) => <p>{alinea}</p>)}
      </div>
    </div>
  </section>

  {voertuigen.length > 0 && (
    <section class="section is-band">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow">Wat je hiervoor inzet</span>
          <h2>De voertuigen die hierbij passen</h2>
        </div>
        <div class="grid is-4">
          {voertuigen.map((v) => <VoertuigKaart voertuig={v} huidigPad={pad} />)}
        </div>
      </div>
    </section>
  )}

  {cases.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow">Al in beweging bij</span>
          <h2>Zo pakte dat uit</h2>
        </div>
        <div class="grid is-3">
          {cases.map((c) => (
            <a class="case-card" href={link(pad, `/cases/${c.data.slug}`)}>
              <h3>{c.data.klant}</h3>
              <p>{c.data.kort}</p>
              <span class="case-rol">Bekijk de case</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaBlok huidigPad={pad} />
</Basis>

<style>
  .hoofdbeeld{width:100%;height:auto;border-radius:var(--radius);margin-top:var(--s-4);}
  .tekst{margin-top:var(--s-6);display:flex;flex-direction:column;gap:var(--s-4);max-width:64ch;}
  .tekst p{color:var(--body);}
</style>
