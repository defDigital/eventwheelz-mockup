---
import { achtergrondKlasse, type Achtergrond } from '../lib/pad';
interface Props { tekst: string; naam: string; rol: string; achtergrond?: Achtergrond; }
const { tekst, naam, rol, achtergrond = 'blauw' } = Astro.props;
---
<section class:list={['section', achtergrondKlasse(achtergrond)]}>
  <div class="wrap">
    <figure class="quote">
      <blockquote data-dummy>{tekst}</blockquote>
      <figcaption>
        <span class="quote-naam">{naam}</span>
        <span class="quote-rol">{rol}</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .quote{margin:0;max-width:52ch;}
  .quote blockquote{
    margin:0;
    font-family:var(--f-display);
    font-size:clamp(1.5rem,1.1rem + 1.6vw,2.2rem);
    line-height:1.2;
    text-transform:uppercase;
    color:var(--white);
  }
  .quote blockquote::before{content:"\201C";color:var(--accent);}
  .quote blockquote::after{content:"\201D";color:var(--accent);}
  figcaption{margin-top:var(--s-5);display:flex;flex-direction:column;gap:2px;}
  .quote-naam{font-weight:700;color:var(--white);}
  .quote-rol{color:#dbe7f6;font-size:.9rem;}
</style>
