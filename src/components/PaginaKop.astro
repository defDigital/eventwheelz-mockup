---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { link } from '../lib/pad';

interface Props {
  eyebrow?: string;
  titel: string;
  intro?: string;
  /** 'tekst' = alleen tekst, 'split' = tekst links en beeld rechts,
   *  'beeld' = foto over de volle breedte met de tekst eroverheen. */
  variant?: 'tekst' | 'split' | 'beeld';
  beeld?: ImageMetadata;
  beeldAlt?: string;
  terug?: { naar: string; label: string };
}

const {
  eyebrow, titel, intro,
  variant = 'tekst',
  beeld, beeldAlt = '',
  terug,
} = Astro.props;

const heeftBeeld = Boolean(beeld);
const soort = heeftBeeld ? variant : 'tekst';
---
<section class:list={['paginakop', `is-${soort}`]}>
  {soort === 'beeld' && beeld && (
    <div class="kop-media">
      <Image src={beeld} alt={beeldAlt} widths={[900, 1500]} sizes="100vw" loading="eager" />
      <div class="kop-sluier"></div>
    </div>
  )}

  <div class="wrap kop-inner">
    <div class="kop-tekst">
      {terug && (
        <a class="kop-terug" href={link(Astro.url.pathname, terug.naar)}>&#8249; {terug.label}</a>
      )}
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <h1>{titel}</h1>
      {intro && <p class="paginakop-intro">{intro}</p>}
      <slot />
    </div>

    {soort === 'split' && beeld && (
      <div class="kop-beeld">
        <Image src={beeld} alt={beeldAlt} widths={[600, 1000]} sizes="(max-width:991px) 100vw, 560px" loading="eager" />
      </div>
    )}
  </div>
</section>

<style>
  .paginakop{
    position:relative;
    background:linear-gradient(155deg,var(--blue),var(--navy) 72%);
    border-bottom:1px solid var(--line);
  }
  .paginakop h1{font-size:clamp(2rem,1.4rem + 3vw,3.4rem);}
  .paginakop-intro{margin-top:var(--s-4);max-width:52ch;color:#e2ecf8;font-size:1.05rem;}

  .kop-terug{
    display:inline-flex;align-items:center;min-height:44px;
    margin-bottom:var(--s-2);
    color:var(--muted);text-decoration:none;font-weight:700;font-size:.85rem;
  }
  .kop-terug:hover{color:var(--white);}

  /* alleen tekst — ruimer dan eerst, zodat de kop niet zo laag oogt */
  .is-tekst .kop-inner{padding-block:var(--s-9) var(--s-9);}

  /* tekst links, beeld rechts */
  .is-split .kop-inner{
    display:grid;grid-template-columns:1fr 1fr;
    gap:var(--s-8);align-items:center;
    padding-block:var(--s-8);
  }
  .kop-beeld{border-radius:var(--radius);overflow:hidden;}
  .kop-beeld :global(img){width:100%;height:100%;aspect-ratio:4/3;object-fit:cover;display:block;}

  /* foto over de volle breedte, tekst eroverheen */
  .is-beeld{border-bottom:0;}
  .is-beeld .kop-inner{
    position:relative;z-index:2;
    padding-block:var(--s-10) var(--s-9);
    min-height:420px;display:flex;align-items:flex-end;
  }
  .kop-media{position:absolute;inset:0;}
  .kop-media :global(img){width:100%;height:100%;object-fit:cover;display:block;}
  .kop-sluier{
    position:absolute;inset:0;
    background:linear-gradient(90deg,
      rgba(8,30,58,.94) 0%,
      rgba(8,30,58,.80) 46%,
      rgba(8,30,58,.42) 100%);
  }

  @media (max-width:991px){
    .is-split .kop-inner{grid-template-columns:1fr;gap:var(--s-5);padding-block:var(--s-7);}
    .is-tekst .kop-inner{padding-block:var(--s-8);}
    .is-beeld .kop-inner{min-height:0;padding-block:var(--s-8);}
    .kop-sluier{background:linear-gradient(0deg,rgba(8,30,58,.94) 40%,rgba(8,30,58,.68) 100%);}
  }
</style>
