---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { achtergrondKlasse, type Achtergrond } from '../lib/pad';

interface Props {
  titel: string;
  eyebrow?: string;
  stappen: { titel: string; tekst: string }[];
  /** 'rij' = vier naast elkaar, 'lijst' = onder elkaar met een foto ernaast. */
  variant?: 'rij' | 'lijst';
  beeld?: ImageMetadata;
  beeldAlt?: string;
  achtergrond?: Achtergrond;
}

const {
  titel,
  eyebrow = 'Zo werkt het',
  stappen,
  variant = 'rij',
  beeld,
  beeldAlt = '',
  achtergrond = 'deep',
} = Astro.props;

const soort = variant === 'lijst' && beeld ? 'lijst' : variant;
---
<section class:list={['section', achtergrondKlasse(achtergrond)]}>
  <div class="wrap">
    {soort === 'lijst' ? (
      <div class="stappen-split">
        <div class="stappen-kolom">
          <div class="section-head">
            <span class="eyebrow">{eyebrow}</span>
            <h2>{titel}</h2>
          </div>
          <ol class="stappen is-lijst">
            {stappen.map((s, i) => (
              <li class="stap">
                <span class="stap-num">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <h3 class="stap-titel">{s.titel}</h3>
                  <p data-dummy>{s.tekst}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
        {beeld && (
          <div class="stappen-beeld">
            <Image src={beeld} alt={beeldAlt} widths={[600, 1000]}
                   sizes="(max-width:991px) 100vw, 520px" loading="lazy" />
          </div>
        )}
      </div>
    ) : (
      <>
      <div class="section-head">
        <span class="eyebrow">{eyebrow}</span>
        <h2>{titel}</h2>
      </div>
      <ol class="stappen is-rij">
        {stappen.map((s, i) => (
          <li class="stap">
            <span class="stap-num">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="stap-titel">{s.titel}</h3>
            <p data-dummy>{s.tekst}</p>
          </li>
        ))}
      </ol>
      </>
    )}
  </div>
</section>

<style>
  .stap-num{
    display:block;
    font-family:var(--f-display);font-size:1.6rem;line-height:1;
    color:var(--accent);
  }
  .stap-titel{
    font-size:1.05rem;text-transform:none;
    font-family:var(--f-body);font-weight:700;line-height:1.35;
    margin-bottom:var(--s-2);
  }
  .stap p{color:var(--body);font-size:.92rem;}

  /* naast elkaar */
  .is-rij{display:grid;grid-template-columns:repeat(4,1fr);gap:var(--s-5);}
  .is-rij .stap{padding-top:var(--s-5);border-top:2px solid var(--accent);}
  .is-rij .stap-num{margin-bottom:var(--s-3);}

  /* onder elkaar, met een foto ernaast */
  .stappen-split{display:grid;grid-template-columns:1.1fr .9fr;gap:var(--s-8);align-items:start;}
  .stappen-kolom .section-head{margin-bottom:var(--s-6);}
  .is-lijst{display:flex;flex-direction:column;}
  .is-lijst .stap{
    display:grid;grid-template-columns:auto 1fr;gap:var(--s-4);
    padding-block:var(--s-5);
    border-top:1px solid var(--line);
  }
  .is-lijst .stap:first-child{border-top:0;padding-top:0;}
  .is-lijst .stap-num{padding-top:2px;}
  .stappen-beeld{border-radius:var(--radius);overflow:hidden;position:sticky;top:110px;}
  .stappen-beeld :global(img){width:100%;height:100%;aspect-ratio:4/5;object-fit:cover;display:block;}

  @media (max-width:991px){
    .is-rij{grid-template-columns:1fr 1fr;}
    .stappen-split{grid-template-columns:1fr;gap:var(--s-5);}
    .stappen-beeld{position:static;}
    .stappen-beeld :global(img){aspect-ratio:16/9;}
  }
  @media (max-width:479px){ .is-rij{grid-template-columns:1fr;} }
</style>
