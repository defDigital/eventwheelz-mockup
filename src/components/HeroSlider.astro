---
import { Image } from 'astro:assets';
import { foto } from '../lib/beeld';

/**
 * Doet precies wat de native Webflow Slider doet: slides, bolletjes, pijlen,
 * autoplay en pauze bij hover. Bij het overzetten vervang je dit door de
 * Slider-component van Webflow, met dezelfde zes afbeeldingen.
 */
const slides = [
  { bestand: 'breed-e-choppers-groep.jpg', alt: 'Groep op e-choppers tijdens een evenement' },
  { bestand: 'breed-tuktuks-onderweg.jpg', alt: 'Twee tuktuks onderweg met gasten' },
  { bestand: 'breed-elektrische-autos.jpg', alt: 'Elektrische voertuigen met gasten op locatie' },
  { bestand: 'breed-fatbikes.jpg', alt: 'Fatbikes klaar voor gebruik op locatie' },
  { bestand: 'breed-tuktuks-klaar.jpg', alt: 'Tuktuks klaar voor vertrek' },
  { bestand: 'breed-levering-aanhanger.jpg', alt: 'Voertuigen worden op locatie geleverd' },
];
---
<div class="slider" data-slider>
  <div class="slider-track">
    {slides.map((s, i) => (
      <div class:list={['slide', i === 0 && 'is-active']} role="group"
           aria-label={`Slide ${i + 1} van ${slides.length}`}>
        <Image src={foto(s.bestand)!} alt={s.alt} widths={[760, 1200, 1500]}
               sizes="100vw" loading={i === 0 ? 'eager' : 'lazy'} />
      </div>
    ))}
  </div>

  <div class="slider-ui">
    <button type="button" class="slider-arrow" data-prev aria-label="Vorige slide">&#8249;</button>
    <div class="slider-dots" role="tablist" aria-label="Slides">
      {slides.map((_, i) => (
        <button type="button" class:list={['slider-dot', i === 0 && 'is-active']}
                data-go={i} aria-label={`Ga naar slide ${i + 1}`}></button>
      ))}
    </div>
    <button type="button" class="slider-arrow" data-next aria-label="Volgende slide">&#8250;</button>
  </div>
</div>

<style>
  .slider{position:relative;height:100%;overflow:hidden;background:var(--deep);}
  .slider-track{position:absolute;inset:0;}
  .slide{position:absolute;inset:0;opacity:0;transition:opacity .7s ease;}
  .slide.is-active{opacity:1;}
  .slide :global(img){width:100%;height:100%;object-fit:cover;}

  .slider-ui{
    position:absolute;right:0;bottom:var(--s-5);left:0;
    display:flex;align-items:center;justify-content:flex-end;gap:var(--s-3);
    padding-inline:max(var(--s-5), calc((100% - var(--wrap)) / 2 + var(--s-5)));
    z-index:2;
  }
  .slider-arrow{
    width:44px;height:44px;
    display:inline-flex;align-items:center;justify-content:center;
    background:rgba(10,58,110,.72);
    border:1px solid rgba(255,255,255,.3);
    border-radius:999px;
    color:var(--white);font-size:1.4rem;line-height:1;
    cursor:pointer;
  }
  .slider-arrow:hover{background:var(--navy);}
  .slider-dots{display:flex;gap:var(--s-2);}
  .slider-dot{
    width:10px;height:10px;padding:0;
    border-radius:999px;border:1px solid rgba(255,255,255,.65);
    background:transparent;cursor:pointer;
  }
  .slider-dot.is-active{background:var(--accent);border-color:var(--accent);}
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-slider]').forEach((root) => {
    const slides = [...root.querySelectorAll<HTMLElement>('.slide')];
    const dots = [...root.querySelectorAll<HTMLElement>('.slider-dot')];
    const stil = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let i = 0, timer: number | undefined;

    const toon = (n: number) => {
      i = (n + slides.length) % slides.length;
      slides.forEach((s, k) => s.classList.toggle('is-active', k === i));
      dots.forEach((d, k) => d.classList.toggle('is-active', k === i));
    };
    const stop = () => { if (timer) { clearInterval(timer); timer = undefined; } };
    const start = () => { if (!stil) { stop(); timer = window.setInterval(() => toon(i + 1), 5200); } };

    dots.forEach((d) => d.addEventListener('click', () => { toon(Number(d.dataset.go)); start(); }));
    root.querySelector('[data-prev]')?.addEventListener('click', () => { toon(i - 1); start(); });
    root.querySelector('[data-next]')?.addEventListener('click', () => { toon(i + 1); start(); });
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    start();
  });
</script>
