---
import { achtergrondKlasse, type Achtergrond } from '../lib/pad';
import { Image } from 'astro:assets';
import { foto } from '../lib/beeld';
interface Props { bestanden: string[]; alt: string; achtergrond?: Achtergrond; }
const { bestanden, alt, achtergrond = 'navy' } = Astro.props;
const beelden = bestanden.map((b) => foto(b)).filter(Boolean);
---
{beelden.length > 0 && (
  <section class:list={['section', achtergrondKlasse(achtergrond)]}>
    <div class="wrap">
      <div class:list={['fotostrook', beelden.length === 1 && 'is-enkel', beelden.length === 2 && 'is-2']}>
        {beelden.map((b) => (
          <Image src={b!} alt={alt} widths={[500, 900]} sizes="(max-width:767px) 100vw, 380px" loading="lazy" />
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .fotostrook{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--s-4);}
  .fotostrook.is-2{grid-template-columns:repeat(2,1fr);}
  /* Zie de galerij op de voertuigpagina: één foto krijgt tekstbreedte. */
  .fotostrook.is-enkel{grid-template-columns:1fr;max-width:64ch;}
  .fotostrook.is-enkel :global(img){height:auto;aspect-ratio:auto;}
  .fotostrook :global(img){width:100%;height:100%;aspect-ratio:4/3;object-fit:cover;border-radius:var(--radius);}
  @media (max-width:767px){ .fotostrook,.fotostrook.is-2,.fotostrook.is-enkel{grid-template-columns:1fr;} }
</style>
